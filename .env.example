# Copia este archivo como .env y coloca tus credenciales reales.

# MySQL
# Reemplaza estos valores por los datos de tu proveedor/instalación local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASS=tu_clave

# URL pública opcional del proyecto para pruebas con ngrok o dominio real.
# Ejemplo: https://abc123.ngrok-free.app/vetwilling
APP_PUBLIC_URL=https://tu-subdominio.ngrok-free.app/vetwilling

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_AQUI
MP_PUBLIC_KEY=APP_USR-TU_PUBLIC_KEY_AQUI

# Base pública usada por Checkout Pro para las URLs de retorno.
MP_PUBLIC_BASE_URL=https://tu-subdominio.ngrok-free.app/vetwilling

# Webhook público recomendado para confirmar pagos y actualizar estados.
MP_WEBHOOK_URL=https://tu-subdominio.ngrok-free.app/vetwilling/pagos/mercadopago?action=webhook
# Correo SMTP (Gmail: usar una "contraseña de aplicación", no la clave normal)
SMTP_USER=vetwillingsoporte@gmail.com
SMTP_PASS=TU_APP_PASSWORD_AQUI
SMTP_FROM_EMAIL=vetwillingsoporte@gmail.com

# Brevo (API HTTP por puerto 443; funciona aunque la red bloquee SMTP)
# Si BREVO_API_KEY tiene valor se usa Brevo; para forzar Gmail SMTP: MAIL_DRIVER=smtp
BREVO_API_KEY=

# Clave para cifrar credenciales guardadas en la base de datos (contraseña SMTP de Medios de envío).
# 32 bytes en base64. Generar con: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Si se pierde, las credenciales cifradas no se pueden recuperar: hay que volver a escribirlas.
APP_ENCRYPTION_KEY=
